PORT=3000
DATA_PATH=./data/store.json
SESSION_SECRET=replace-with-at-least-32-random-characters

# Set to enable PostgreSQL-backed /v1 identity, consent, safety and tutor traces.
DATABASE_URL=
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000

# Optional grounded tutor generation.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=provider/model-id
AI_TIMEOUT_MS=12000
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# Optional evidence-search service. Results are filtered by trusted domains.
EVIDENCE_SEARCH_URL=
EVIDENCE_SEARCH_API_KEY=
TRUSTED_EVIDENCE_DOMAINS=usgs.gov,nasa.gov,science.nasa.gov,nih.gov,cdc.gov,noaa.gov,si.edu,edu
